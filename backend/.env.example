# Server
PORT=4000

# mock: deterministic seeded data (default, no credentials needed)
# live: real vendor APIs using the credentials below
DATA_SOURCE=mock

# --- Microsoft Teams (Graph, OAuth2 client credentials) ---
# Azure AD app registration with application permissions:
#   TeamworkDevice.Read.All, User.Read.All, Place.Read.All, CallRecords.Read.All
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Cisco Webex (bearer token) ---
# Admin-scoped token or service-app token with scopes:
#   spark-admin:devices_read, spark-admin:workspaces_read,
#   spark-admin:people_read, spark-admin:telephony_config_read
WEBEX_ACCESS_TOKEN=

# --- Poly Lens (API connection credentials) ---
# Create an API connection in Poly Lens (Account > API Connections);
# the client id/secret are exchanged for a token at login.lens.poly.com.
POLY_LENS_CLIENT_ID=
POLY_LENS_API_SECRET=

# --- Sign-in (optional; app runs in guest mode if unset) ---
# Absolute URL of the deployed app, used to build OAuth redirect URIs.
APP_BASE_URL=https://uc-inventory-lcm-and-pm.onrender.com
# Long random string; keeps login sessions valid across restarts.
SESSION_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID, type "Web application").
# Authorized redirect URI: {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure Portal > App registrations > new registration,
# "Accounts in any org directory and personal accounts").
# Redirect URI (Web): {APP_BASE_URL}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Login-alert email (Resend) ---
# API key from resend.com; ALERT_EMAIL_TO is where alerts are sent.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Until you verify a domain in Resend, keep the default onboarding sender.
ALERT_EMAIL_FROM=Fleetline <onboarding@resend.dev>

# --- Persistence (optional; in-memory if unset) ---
# Postgres connection string. When set, project & phone-number edits/imports
# survive restarts. On Render use the database's Internal Connection String.
DATABASE_URL=
