# Server
PORT=4000

# mock: deterministic seeded data (default, no credentials needed)
# live: real vendor APIs using the credentials below
DATA_SOURCE=mock

# --- Microsoft Teams (Graph, OAuth2 client credentials) ---
# Azure AD app registration with application permissions:
#   TeamworkDevice.Read.All, User.Read.All, Place.Read.All, CallRecords.Read.All
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Cisco Webex (bearer token) ---
# Admin-scoped token or service-app token with scopes:
#   spark-admin:devices_read, spark-admin:workspaces_read,
#   spark-admin:people_read, spark-admin:telephony_config_read
WEBEX_ACCESS_TOKEN=

# --- Poly Lens (API connection credentials) ---
# Create an API connection in Poly Lens (Account > API Connections);
# the client id/secret are exchanged for a token at login.lens.poly.com.
POLY_LENS_CLIENT_ID=
POLY_LENS_API_SECRET=
